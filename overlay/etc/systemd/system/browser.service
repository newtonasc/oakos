[Unit]
Description=Chromium headful -- aberto na tela virtual pra ver apps rodando na VM
After=wm.service launcher.service
Requires=wm.service launcher.service

[Service]
Type=simple
Environment=DISPLAY=:0
# --no-sandbox: obrigatorio rodando como root (Chromium recusa o sandbox de
# namespaces nesse caso e sai de cara sem essa flag). Abre no launcher
# (127.0.0.1:7000, ver launcher.service) em vez de about:blank -- pagina
# local, sem depender de rede pra abrir, com os icones grandes de Shell,
# Claude, Chrome, Herdr, IDE e Explorer.
#
# --app (nao --kiosk): mesmo efeito visual -- sem barra de endereco, sem
# abas, sem decoracao (essa ultima parte quem tira e o fluxbox, ver
# overlay/root/.fluxbox/apps, que casa pelo WM_CLASS "127.0.0.1" que o
# --app assume) -- mas sem o --kiosk pedir o estado de tela cheia do proprio X11
# (_NET_WM_STATE_FULLSCREEN). Motivo, achado testando: fluxbox trata
# janelas fullscreen numa camada especial que NAO reordena com janela
# nova nenhuma -- a dock (oakos-dock) depende de trazer esta janela de
# volta pra frente (ou abrir uma nova, se isso falhar), e isso so
# funciona se ela ficar na camada normal de empilhamento.
# --test-type: sem ele o Chromium mostra uma faixa amarela por cima do
# totem avisando que '--no-sandbox' e flag nao suportada -- mesmo truque
# que Selenium/Puppeteer usam ha anos pra rodar Chromium como root sem
# essa faixa.
# Restart=always (em vez de on-failure): se mesmo assim alguem conseguir
# fechar, volta sozinho em poucos segundos, saia como sair (sucesso ou
# erro).
ExecStart=/usr/bin/chromium --no-sandbox --test-type --app=http://127.0.0.1:7000/
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
