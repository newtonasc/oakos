[Unit]
Description=code-server -- IDE web do OakOS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# 127.0.0.1: nao expomos a IDE pra rede nenhuma alem do proprio host QEMU
# (o acesso de fora vem do hostfwd em run.sh, nao daqui). Sem --auth: o
# code-server usa o padrao dele mesmo (auth: password), que na primeira vez
# que roda gera uma senha aleatoria sozinho e grava em
# ~/.config/code-server/config.yaml -- esse diretorio esta montado no disco
# de dados persistente (ver overlay/etc/fstab), entao a senha sobrevive a
# reinicios e rebuilds em vez de mudar toda hora. O 'oak' le e mostra essa
# senha (ver status()/loggedIn-style checks no overlay/usr/local/bin/oak).
ExecStart=/usr/local/bin/code-server \
    --bind-addr 127.0.0.1:8080 \
    --disable-telemetry \
    /root/workspace
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
